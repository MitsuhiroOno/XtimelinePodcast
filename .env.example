# Anthropic (Claude) API キー。 https://console.anthropic.com で発行します。
ANTHROPIC_API_KEY=

# 会話台本生成に使うモデル。省略時は claude-sonnet-5 を使用します。
# 品質を優先する場合は claude-opus-5、速度/コストを優先する場合は claude-haiku-4-5-20251001 なども指定できます。
ANTHROPIC_MODEL=claude-sonnet-5

# twitter-cli (https://github.com/public-clis/twitter-cli) の実行ファイル名/パス。
# `uv tool install twitter-cli` や `pipx install twitter-cli` でインストールした場合は通常 "twitter" のままで動作します。
TWITTER_CLI_BIN=twitter

# --- 音声化（speak / --audio）を使う場合 ---
# OpenAI APIキー。 https://platform.openai.com で発行します。
OPENAI_API_KEY=

# 音声合成に使うモデル。省略時は gpt-4o-mini-tts を使用します。
OPENAI_TTS_MODEL=gpt-4o-mini-tts
